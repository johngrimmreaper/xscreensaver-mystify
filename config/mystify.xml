<?xml version="1.0" encoding="ISO-8859-1"?>

<screensaver name="mystify" _label="Mystify">

  <command arg="--root"/>

  <hgroup>
   <vgroup>
    <number id="delay" type="slider" arg="--delay %"
            _label="Frame rate" _low-label="Low" _high-label="High"
            low="10000" high="120000" default="30000"
            convert="invert"/>

    <number id="polygons" type="spinbutton" arg="--polys %"
            _label="Moving polygons"
            low="1" high="8" default="2"/>

    <number id="points" type="spinbutton" arg="--points %"
            _label="Corners per polygon"
            low="3" high="15" default="4"/>

    <number id="trails" type="slider" arg="--trails %"
            _label="Trailing wires" _low-label="Short" _high-label="Long"
            low="0" high="24" default="5"/>
   </vgroup>

   <vgroup>
    <number id="speed" type="slider" arg="--speed %"
            _label="Corner speed" _low-label="Slow" _high-label="Fast"
            low="2" high="40" default="14"/>

    <number id="thickness" type="spinbutton" arg="--thickness %"
            _label="Line thickness"
            low="1" high="8" default="1"/>

    <number id="colors" type="spinbutton" arg="--colors %"
            _label="Color steps"
            low="8" high="128" default="64"/>

    <boolean id="showfps" _label="Show frame rate" arg-set="--fps"/>
   </vgroup>
  </hgroup>

  <xscreensaver-updater />

  <_description>
Colorful wire polygons deform as their corners bounce independently around
the screen, inspired by the classic Windows 95 and Windows 98 Mystify screen
saver.

Written by Reaper; 2026.
  </_description>
</screensaver>
